# 1. 보안 파일 (가장 중요!)
.env

# 2. 가상환경 폴더 (용량 큼, OS 호환 안 됨)
venv/
env/

# 3. 파이썬 컴파일/캐시 데이터 (임시 파일)
__pycache__/
*.pyc
cache/

# 4. 데이터베이스 (로컬 테스트용 DB는 제외)
*.db
*.sqlite3

# 5. 임시/분석 스크립트 (API 키 포함 가능)
fix_trades.py
analyze_trades.py
analyze_*.py
check_db.py
fix_*.py

# 6. ML 모델 파일
models/

# 7. 로그 파일
logs/

# 6. OS 생성 파일 (맥/윈도우 썸네일 등)
.DS_Store
Thumbs.db
# 8. 개발 전용 문서 (로컬에서만 관리)
CLAUDE.md
